{
  "name": "crona",
  "private": true,
  "version": "0.1.0",
  "description": "CRONA - tabuleiro digital isométrico multiplayer (quartos, personagens, mobis, chat)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @crona/server",
    "dev:client": "npm run dev -w @crona/client",
    "build": "npm run build -w @crona/client",
    "start": "npm run start -w @crona/server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client && tsc -p .claude/skills/verissimo",
    "test": "npm run test -w @crona/server",
    "banco": "docker compose up -d --wait banco",
    "banco:parar": "docker compose stop banco",
    "banco:backup": "node scripts/banco.mjs backup",
    "banco:restaurar": "node scripts/banco.mjs restaurar",
    "arte:poses": "python scripts/poses.py",
    "arte:boneco": "python scripts/boneco.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
